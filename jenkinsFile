pipeline {
    agent any
       tools {
            maven 'MVN_HOME'
            }

    stages {
        stage('SCM-CONFIG') {
            steps {
                git branch: 'main', url: 'https://github.com/JoelAsir/my-app.git'
        
            }
        }
        stage('MAVEN BUILD') {
            steps {
            
                sh 'mvn compile'
            }
         }
         stage('MAVEN DEPLOY') {
            steps {
            
                sh 'mvn package'
            }
         }
     }
}
