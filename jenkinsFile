pipeline {
    agent any
       tools {
            maven 'MVN_HOME'
            }

    stages {
        stage('SCM-CONFIG') {
            steps {
                git branch: 'maincourse', url: 'https://github.com/JoelAsir/JoelAsirGitTraining.git'
            }
        }
        stage('MAVEN BUILD') {
            steps {
                mvn compile
            }
         }
     }
}
