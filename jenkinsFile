pipeline {
    agent any

    stages {
        stage('SCM-CONFIG') {
            steps {
                git branch: 'maincourse', url: 'https://github.com/JoelAsir/JoelAsirGitTraining.git'
            }
        }
        stage('MAVEN BUILD') {
            steps {
                echo 'Hello World.This is my first Descriptive pipeline'
            }
         }
     }
}
