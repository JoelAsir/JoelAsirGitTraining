pipeline {
    agent any
       tools {
            maven 'mvn_home'
               }
    stages {
        stage(‘SCM-Checkout’) {
            steps {
                git branch: 'maincourse', url: 'https://github.com/JoelAsir/JoelAsirGitTraining.git'

            }
        }
        stage(‘Maven-build’) {
            steps {
                echo ’This is Maven Build’
                 mvn compile
            }
        }
       stage(‘Maven-deploy’) {
            steps {
                echo ’This is Maven Deploy’
                mvn deploy
            }
        }
    }
}
